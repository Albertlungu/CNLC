# Google Calendar OAuth credentials
# Create a project at https://console.cloud.google.com
# Enable the Google Calendar API
# Create OAuth 2.0 credentials (Web application type)
# Add http://127.0.0.1:5001/api/calendar/callback as an authorized redirect URI

GOOGLE_CALENDAR_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret-here
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:5001/api/calendar/callback

# reCAPTCHA (optional)
# RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
